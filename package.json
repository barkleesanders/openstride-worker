{
  "name": "openstride-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source personal running planner on Cloudflare Workers and D1",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check . --error-on-warnings",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:runtime",
    "check:runtime": "node scripts/check-runtime.mjs",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "probe:constrained": "node tests/probe-constrained.mjs probe"
  },
  "dependencies": {
    "hono": "4.13.13",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "22.20.2",
    "miniflare": "5.20261019.1-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
